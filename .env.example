# Copy to .env (or export these) before `npm start`.
# Everything here is optional — Bla runs with sane defaults out of the box.

# ── Where it listens ─────────────────────────────────────────────────
BLA_HOST=0.0.0.0
BLA_PORT=3000
# Behind nginx/Caddy: bind locally and let the proxy own the outside world.
# BLA_HOST=127.0.0.1
# BLA_TRUST_PROXY=true
# BLA_PUBLIC_URL=https://chat.example.com

# ── Branding ─────────────────────────────────────────────────────────
BLA_SERVER_NAME=Bla

# ── Signups ──────────────────────────────────────────────────────────
BLA_REGISTRATION_OPEN=true
BLA_INVITE_ONLY=false
# Comma-separated usernames that should be instance admins.
# BLA_ADMINS=you,someone-else

# ── Storage ──────────────────────────────────────────────────────────
BLA_DATA_DIR=./data
# BLA_DB=./data/bla.db

# ── Free-forever limits (no payment code exists in this project) ─────
BLA_MAX_UPLOAD_MB=100
BLA_MAX_AVATAR_MB=8
BLA_VOICE_BITRATE=384000
BLA_MAX_EMOJI=500
BLA_MAX_STICKERS=120
BLA_MAX_GUILDS_PER_USER=200
# BLA_MAX_USERS=0            # 0 = unlimited

# ── Voice (WebRTC) ───────────────────────────────────────────────────
# STUN works out of the box; add your own TURN server for strict NATs.
BLA_STUN_URLS=stun:stun.l.google.com:19302
# BLA_STUN_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp
